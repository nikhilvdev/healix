"""Fill-and-click script for {{ pages|length }} page(s), generated by Healix {{ version }} ({{ backend }}).

It types into each page's inputs and clicks its submit button, with no assertions. Run it with
``python {{ "actions_" ~ backend }}.py``. Every step goes through ``healix.Healer``: when a page's ids
or classes change, the element is found again and the fix is recorded in the fingerprint database.
"""

from __future__ import annotations

{% include "_imports.j2" %}

{% include "_session.j2" %}
{% for page in pages %}


def run_{{ page.function_name }}(healer: Healer) -> None:
    """The {{ page.page_type }} page."""
    url = {{ page.url|py }}
    healer.driver.navigate(url)
{% for step in page.steps %}
{% if step.action == "fill" %}
    healer.write({{ step.value }}, url, {{ step.role|py }}, navigate=False)
{% else %}
    healer.click(url, {{ step.role|py }}, navigate=False)
{% endif %}
{% endfor %}
{% endfor %}


PAGES = [
{% for page in pages %}
    run_{{ page.function_name }},
{% endfor %}
]


def main() -> None:
    with session() as healer:
        for run_page in PAGES:
            run_page(healer)


if __name__ == "__main__":
    main()
