"""Page objects for {{ pages|length }} page(s), generated by Healix {{ version }} ({{ backend }}).

One class per page, with a method for each element. Use them from any test runner::

    with session() as healer:
        {{ pages[0].class_name }}(healer).open()

Every method goes through ``healix.Healer``: when a page's ids or classes change, the element is found
again and the fix is recorded in the fingerprint database. ``fill_*`` types into an input,
``click_*`` clicks, and ``locate_*`` returns the element without acting on it.
"""

from __future__ import annotations

{% include "_imports.j2" %}

{% include "_session.j2" %}
{% for page in pages %}


class {{ page.class_name }}:
    """The {{ page.page_type }} page."""

    URL = {{ page.url|py }}

    def __init__(self, healer: Healer) -> None:
        self.healer = healer

    def open(self) -> {{ page.class_name }}:
        self.healer.driver.navigate(self.URL)
        return self
{% for element in page.elements %}
{% if element.action == "fill" %}

    def {{ element.method }}(self, value: str | None = None) -> {{ page.class_name }}:
        text = {{ element.value }} if value is None else value
        self.healer.write(text, self.URL, {{ element.role|py }}, navigate=False)
        return self
{% elif element.action == "click" %}

    def {{ element.method }}(self) -> {{ page.class_name }}:
        self.healer.click(self.URL, {{ element.role|py }}, navigate=False)
        return self
{% else %}

    def {{ element.method }}(self) -> Element:
        return self.healer.resolve(self.URL, {{ element.role|py }}, navigate=False).element
{% endif %}
{% endfor %}
{% endfor %}
