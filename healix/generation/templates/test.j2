"""Tests for {{ pages|length }} page(s), generated by Healix {{ version }} ({{ backend }}).

Each test opens a page, checks the address, and checks that every element is found, visible, and
(for controls that were enabled) enabled. Nothing is typed or clicked, so they are safe to run
against a live site. Run them with ``pytest``. Every lookup goes through ``healix.Healer``: when a
page's ids or classes change the element is found again, and the fix is recorded.
"""

from __future__ import annotations

{% include "_imports.j2" %}

{% include "_session.j2" %}


@pytest.fixture(scope="module")
def healer() -> Iterator[Healer]:
    with session() as healer:
        yield healer
{% for page in pages %}


{{ page.function_name|upper }}_URL = {{ page.url|py }}
{{ page.function_name|upper }}_ELEMENTS = [  # (role, expected to be enabled)
{% for element in page.elements %}
    ({{ element.role|py }}, {{ element.enabled }}),
{% endfor %}
]


def test_{{ page.function_name }}(healer: Healer) -> None:
    healer.driver.navigate({{ page.function_name|upper }}_URL)
    assert urlsplit(healer.driver.current_url).path.rstrip("/") == {{ page.path|py }}
    for role, enabled in {{ page.function_name|upper }}_ELEMENTS:
        element = healer.resolve({{ page.function_name|upper }}_URL, role, navigate=False).element
        assert element.computed.get("visible"), f"{role} is not visible"
        if enabled:
            assert element.computed.get("enabled", True), f"{role} is not enabled"
{% endfor %}
